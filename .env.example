# Existing production GigOps intake contract. Never expose the secret to browser code.
GIGOPS_PUBLIC_LEAD_URL="https://app.djsikuya.com/api/public/djsikuya-leads"
GIGOPS_PUBLIC_LEAD_SECRET=""

# Fixed email backup used only when GigOps returns a server error or is unreachable.
RESEND_API_KEY=""

# Supported aliases for alternate environments.
GIGOPS_LEAD_ENDPOINT=""
GIGOPS_LEAD_WEBHOOK_SECRET=""

# Optional future planning endpoint for confirmed clients.
GIGOPS_PLANNING_ENDPOINT=""

# Local preview only. A preview submission returns success without sending data.
BOOKING_PREVIEW_MODE="false"
